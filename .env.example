# ============================================================================
#  C3i-Hub IoT Security Testbed - Environment Configuration
#  Copy to `.env` and edit.  Never commit the real .env.
# ============================================================================

# ---- Core -----------------------------------------------------------------
C3I_ENV=development                # development | production
C3I_HOST=0.0.0.0
C3I_PORT=8080
C3I_LOG_LEVEL=INFO
C3I_DATA_DIR=./data                # SQLite DB, evidence, reports, caches

# ---- Security -------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
C3I_SECRET_KEY=change-me-in-production-please-32-bytes-min
C3I_ACCESS_TOKEN_TTL_MIN=480
C3I_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Bootstrap admin (created on first run if no users exist)
C3I_ADMIN_USER=admin
C3I_ADMIN_PASSWORD=change-me-on-first-login

# Set to true to completely disable authentication (DEV ONLY)
C3I_DEV_NO_AUTH=false

# ---- Safety gate ----------------------------------------------------------
# Master switch. Invasive (ACTIVE/INVASIVE) modules cannot run unless this is
# true AND the engagement carries a valid signed Rules-of-Engagement token.
C3I_ENABLE_INVASIVE=false

# ---- Vulnerability intelligence ------------------------------------------
C3I_NVD_API_KEY=                  # optional, raises NVD rate limit 5->50 req/30s
C3I_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
C3I_OSV_BASE_URL=https://api.osv.dev/v1
C3I_EPSS_BASE_URL=https://api.first.org/data/v1/epss
C3I_CVE_ONLINE=true               # allow on-demand online lookup when offline DB misses
C3I_CVE_DB_PATH=./data/cve/cve.db # local vulnerability cache

# ---- Hardware Testbed (Raspberry Pi 5) ------------------------------------
UART_PORT=                        # auto-detected if blank (/dev/serial0, ttyUSB*, ...)
UART_BAUD_DEFAULT=115200
RELAY_POWER_PIN=6
OCTOCOUPLER_POWER_PIN=22
CHANNEL_PIN=26
VOLTAGE_GLITCH_PIN=20
SPI_BUS=0
SPI_DEVICE=0
FLASHROM_BIN=flashrom

# ---- AI assistant (optional) ---------------------------------------------
C3I_ASSISTANT_ENABLED=false
C3I_OLLAMA_URL=http://127.0.0.1:11434
C3I_OLLAMA_MODEL=qwen2.5:3b
C3I_EMBED_MODEL=nomic-embed-text
